# The Razorpay MCP server is a separate upstream clone with its own .git.
# Never vendor it into this repository -- see docs/DEFECT_LOG.md entry 2026-08-31-01.
razorpay-mcp-server/

# BenchRec is external data, CC BY 4.0, ~26 MB. Downloaded, never committed.
# Provenance and attribution: docs/ARCHITECTURE.md, README.md.
data/benchrec/

# The agent's evidence ledger is written per run by `run.py agent --write`. Nothing
# serves it and no test pins it, so a committed copy would only ever be a stale one.
# Re-create it by running the agent; the run itself is the artefact.
reports/evidence_ledger.json

# Secrets. The LLM tier and the Razorpay MCP both read from here.
.env
*.key

# Python
*.egg-info/
build/
dist/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node / Vite
node_modules/
ui/dist/
ui/.vite/

# OS
desktop.ini
.DS_Store

# Session handoff. A working note for whoever picks this up next -- current state,
# where the bodies are buried, what the numbers actually mean. Deliberately NOT
# committed: it is scratch continuity, not a submission artefact, and it goes stale
# the moment the next session starts changing things. The durable record is
# DEFECT_LOG.md, OUTSTANDING_TASKS.md and the metrics block.
docs/SESSION_HANDOFF.md
